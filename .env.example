# Salin ke .env.local.
# Database SQLite (node:sqlite bawaan Node). Default: data/app.db
# Dipakai hanya saat NETLIFY_DB_URL tidak tersedia (dev lokal di luar Netlify).
APP_DB_FILE=
# Email yang otomatis jadi admin bank soal (pisahkan dengan koma)
ADMIN_EMAILS=admin@contoh.test
# Set 1 jika situs diakses lewat HTTPS
COOKIE_SECURE=0
